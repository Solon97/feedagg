"use client";

import { useState, useCallback } from "react";
import type { CreateSavedContentParams } from "@/core/entities/saved-content.entity";

interface UseSaveContentResult {
  saveContent: (
    contentItemId: string,
    params?: Partial<CreateSavedContentParams>
  ) => Promise<boolean>;
  unsaveContent: (contentItemId: string) => Promise<boolean>;
  toggleSave: (
    contentItemId: string,
    params?: Partial<CreateSavedContentParams>
  ) => Promise<boolean>;
  isSaving: boolean;
  error: string | null;
}

export function useSaveContent(userId: string): UseSaveContentResult {
  const [isSaving, setIsSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const saveContent = useCallback(
    async (
      contentItemId: string,
      params: Partial<CreateSavedContentParams> = {}
    ): Promise<boolean> => {
      try {
        setIsSaving(true);
        setError(null);

        const saveParams: CreateSavedContentParams = {
          userId,
          contentItemId,
          isRead: false,
          isFavorite: false,
          notes: null,
          tags: [],
          ...params,
        };

        const response = await fetch('/api/saved-content', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: "include",
          body: JSON.stringify(saveParams),
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error || "Failed to save content");
        }

        return true;
      } catch (err) {
        const errorMessage =
          err instanceof Error ? err.message : "Failed to save content";
        setError(errorMessage);
        return false;
      } finally {
        setIsSaving(false);
      }
    },
    [userId]
  );

  const unsaveContent = useCallback(
    async (contentItemId: string): Promise<boolean> => {
      try {
        setIsSaving(true);
        setError(null);

        // First find the saved content by user and content item
        const searchParams = new URLSearchParams();
        searchParams.append('userId', userId);
        searchParams.append('contentItemId', contentItemId);

        const findResponse = await fetch(`/api/saved-content?${searchParams}`, {
          credentials: "include",
        });

        if (!findResponse.ok) {
          throw new Error("Failed to find saved content");
        }

        const savedContentList = await findResponse.json();

        if (savedContentList.length > 0) {
          const savedContent = savedContentList[0];
          const deleteResponse = await fetch(`/api/saved-content/${savedContent.id}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            },
            credentials: "include",
            body: JSON.stringify({ userId }),
          });

          if (!deleteResponse.ok) {
            const errorData = await deleteResponse.json();
            throw new Error(errorData.error || "Failed to unsave content");
          }

          return true;
        } else {
          // Content was not saved, return true as it's already "unsaved"
          return true;
        }
      } catch (err) {
        const errorMessage =
          err instanceof Error ? err.message : "Failed to unsave content";
        setError(errorMessage);
        return false;
      } finally {
        setIsSaving(false);
      }
    },
    [userId]
  );

  const toggleSave = useCallback(
    async (
      contentItemId: string,
      params: Partial<CreateSavedContentParams> = {}
    ): Promise<boolean> => {
      try {
        setIsSaving(true);
        setError(null);

        // Check if content is already saved
        const searchParams = new URLSearchParams();
        searchParams.append('userId', userId);
        searchParams.append('contentItemId', contentItemId);

        const findResponse = await fetch(`/api/saved-content?${searchParams}`, {
          credentials: "include",
        });

        if (!findResponse.ok) {
          throw new Error("Failed to check saved content");
        }

        const savedContentList = await findResponse.json();

        if (savedContentList.length > 0) {
          // Content is saved, unsave it
          return await unsaveContent(contentItemId);
        } else {
          // Content is not saved, save it
          return await saveContent(contentItemId, params);
        }
      } catch (err) {
        const errorMessage =
          err instanceof Error ? err.message : "Failed to toggle save";
        setError(errorMessage);
        return false;
      } finally {
        setIsSaving(false);
      }
    },
    [userId, saveContent, unsaveContent]
  );

  return {
    saveContent,
    unsaveContent,
    toggleSave,
    isSaving,
    error,
  };
}
