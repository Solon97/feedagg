"use client";

import { useState, useEffect, useCallback } from "react";
import type { ContentItem } from "@/core/entities/content-item.entity";

interface FeedContentFilters {
  contentTypes: string[];
  sources: string[];
  searchQuery: string;
  sortBy: "newest" | "oldest";
}

interface ContentItemQuery {
  limit?: number;
  offset?: number;
  sortBy?: string;
  sortOrder?: "asc" | "desc";
  search?: string;
  contentTypes?: Array<"article" | "video" | "podcast" | "other">;
  sourceIds?: string[];
}

interface UseFeedContentResult {
  contentItems: ContentItem[];
  isLoading: boolean;
  error: string | null;
  filters: FeedContentFilters;
  updateFilters: (newFilters: Partial<FeedContentFilters>) => void;
  refreshContent: () => Promise<void>;
  hasMore: boolean;
  loadMore: () => Promise<void>;
}

const DEFAULT_FILTERS: FeedContentFilters = {
  contentTypes: [],
  sources: [],
  searchQuery: "",
  sortBy: "newest",
};

export function useFeedContent(): UseFeedContentResult {
  const [contentItems, setContentItems] = useState<ContentItem[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [filters, setFilters] = useState<FeedContentFilters>(DEFAULT_FILTERS);
  const [hasMore, setHasMore] = useState(true);
  const [currentPage, setCurrentPage] = useState(1);

  const buildQuery = useCallback(
    (page: number = 1): ContentItemQuery => {
      const query: ContentItemQuery = {
        limit: 20,
        offset: (page - 1) * 20,
        sortBy: filters.sortBy === "newest" ? "published_at" : "published_at",
        sortOrder: filters.sortBy === "oldest" ? "asc" : "desc",
      };

      if (filters.searchQuery) {
        query.search = filters.searchQuery;
      }

      if (filters.contentTypes.length > 0) {
        query.contentTypes = filters.contentTypes as Array<
          "article" | "video" | "podcast" | "other"
        >;
      }

      if (filters.sources.length > 0) {
        query.sourceIds = filters.sources;
      }

      return query;
    },
    [filters]
  );

  const loadContent = useCallback(
    async (page: number = 1, append: boolean = false) => {
      try {
        setIsLoading(true);
        setError(null);

        const query = buildQuery(page);
        
        // Use Next.js API instead of use cases
        const searchParams = new URLSearchParams();
        if (query.limit) searchParams.append('limit', query.limit.toString());
        if (query.offset) searchParams.append('offset', query.offset.toString());
        if (query.sortBy) searchParams.append('sortBy', query.sortBy);
        if (query.sortOrder) searchParams.append('sortOrder', query.sortOrder);
        if (query.search) searchParams.append('search', query.search);
        if (query.contentTypes) searchParams.append('contentTypes', query.contentTypes.join(','));
        if (query.sourceIds) searchParams.append('sourceIds', query.sourceIds.join(','));

        const response = await fetch(`/api/content-items?${searchParams}`, {
          credentials: "include",
        });

        if (!response.ok) {
          throw new Error("Failed to fetch content items");
        }

        const newItems = await response.json();
        
        setContentItems((prev) =>
          append ? [...prev, ...newItems] : newItems
        );
        setHasMore(newItems.length === query.limit);
        setCurrentPage(page);
      } catch (err) {
        setError(err instanceof Error ? err.message : "Failed to load content");
      } finally {
        setIsLoading(false);
      }
    },
    [buildQuery]
  );

  const updateFilters = useCallback(
    (newFilters: Partial<FeedContentFilters>) => {
      setFilters((prev) => ({ ...prev, ...newFilters }));
      setCurrentPage(1);
    },
    []
  );

  const refreshContent = useCallback(async () => {
    await loadContent(1, false);
  }, [loadContent]);

  const loadMore = useCallback(async () => {
    if (!hasMore || isLoading) return;
    await loadContent(currentPage + 1, true);
  }, [hasMore, isLoading, currentPage, loadContent]);

  // Load initial content
  useEffect(() => {
    loadContent(1, false);
  }, [loadContent]);

  return {
    contentItems,
    isLoading,
    error,
    filters,
    updateFilters,
    refreshContent,
    hasMore,
    loadMore,
  };
}
